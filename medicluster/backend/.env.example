# ── Database / core ──────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/medicluster
ML_ENGINE_URL=http://localhost:8000
PORT=5000
JWT_SECRET=change_me_to_a_long_random_secret

# ── LLM provider (Ollama) ────────────────────────────────────────────────────
# Operation mode:
#   cloud  → use Ollama Cloud only (no local daemon ever).
#   local  → use local daemon only, ignore any cloud keys.
#   auto   → whichever is reachable (default).
OLLAMA_MODE=cloud

# Base URL for the Ollama daemon or Ollama Cloud.
#   Local daemon:        http://localhost:11434
#   Ollama Cloud:        https://ollama.com
OLLAMA_URL=https://ollama.com

# API key(s) for Ollama Cloud. Provide one of:
#   OLLAMA_API_KEY       single key
#   OLLAMA_API_KEYS      comma-separated list, tried in order with rotation.
#                        Each entry supports "label|key" or "label|key|region"
#                        (label is logged, region is informational only).
#                        On a 401/403/429 from any key, the client marks it
#                        unhealthy for OLLAMA_KEY_COOLDOWN_MS (default 60s)
#                        and moves on to the next key.
# Examples:
#   OLLAMA_API_KEY=ollama_…
#   OLLAMA_API_KEYS=primary|ollama_AAA…,backup-eu|ollama_BBB…,ap-acct|ollama_CCC…|ap
OLLAMA_API_KEY=
OLLAMA_API_KEYS=

# How long (ms) a key stays disabled after a hard failure (401/403/429).
OLLAMA_KEY_COOLDOWN_MS=60000

# Default models. Leave blank to auto-detect from /api/tags (preferring
# nemotron / minimax / vision-capable names). Set these to pin specific models.
#
# Popular vision picks (auto-detected when blank):
#   minimax-m3:cloud · minimax-m2.7:cloud
#   gemma4:31b-cloud · gemma3:27b
#   qwen3-vl:8b · qwen2.5-vl:32b
#   kimi-vl · kimi-k3:cloud
#   llama3.2-vision · llava:13b
#   mistral-large-3 · pixtral:12b
#   glm-5.1:cloud · glm-4v
#   deepseek-v4-flash · nemotron-3-vl
#   internvl2:26b · molmo:7b
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=

# Comma-separated priority order for vision/text selection, e.g.
# "minimax,gemma,qwen" puts minimax models first. Leave blank for default order.
OLLAMA_PREFERRED_FAMILIES=

# ── Legacy keys (no longer used by the backend; left for reference) ───────────
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
